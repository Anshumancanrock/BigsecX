# Solana RPC: one endpoint, or several separated by commas in order of
# preference. A call fails over to the next endpoint when one is unreachable,
# times out or rate limits, and a method an endpoint refuses is asked of the
# others. Unset, the API uses publicnode then api.mainnet-beta.solana.com, and
# the indexer the same pair in reverse so its passes use a different endpoint.
# Public endpoints rate limit hard and publicnode refuses indexed calls
# (getTokenAccountsByOwner); a provider endpoint (Helius, QuickNode, Triton)
# raises the ceiling, most of all for the indexer.
# SOLANA_RPC_URL=https://solana-rpc.publicnode.com,https://api.mainnet-beta.solana.com

# Jupiter. Without a key requests go to lite-api.jup.ag, whose keyless quota
# is small: an eight-leg basket needs sixteen calls. With a key requests move
# to api.jup.ag and the client raises its rate budget to match.
# JUPITER_API_KEY=

# Pyth. Hermes rejects price reads without a key (HTTP 401), so without one the
# oracle column in /api/price-truth is absent and only the issuer mark is used.
# PYTH_API_KEY=

# SQLite database shared by the API and the indexer. Defaults to
# data/prestocks.db at the repository root, whatever the working directory.
# DATABASE_PATH=

# A separate RPC endpoint for the indexer, used by `bun run start`. It makes
# hundreds of calls a pass, so on free endpoints it is best kept apart from
# the API's.
# INDEXER_RPC_URL=https://solana-rpc.publicnode.com

# Indexer cadence and per-pass work.
# INDEXER_INTERVAL_MS=300000
# SIGNATURES_PER_MINT=15
# INDEXER_ONCE=1

# Wallet signatures on mutating routes. On by default; set to 0 only for local
# work.
# REQUIRE_WALLET_SIGNATURE=1

# API port. `bun run start` uses API_PORT (default 3111) and WEB_PORT
# (default 4000) instead, and points the site's /api proxy at the API.
# PORT=3000
# API_PORT=3111

# --- apps/web -----------------------------------------------------------

# Where the browser sends API requests. Empty means same origin, which is the
# build default and what preview.ts serves (the API proxied under /api). Set it
# only when the API is on another origin, which must then allow this one.
# API_BASE=

# Dev server port for apps/web, and where its proxy finds the API.
# WEB_PORT=3000
# API_ORIGIN=http://localhost:3111

# Origins allowed to call the API from a browser. Unset allows any, which is
# right locally and wrong in production: the build and submit routes spend a
# shared upstream quota.
# ALLOWED_ORIGINS=https://bigsec.app,https://www.bigsec.app

# Trust X-Forwarded-For / X-Real-IP for rate-limit identity. Off by default,
# since honouring the header without a proxy lets a caller pick its own
# bucket. Set to 1 only behind a proxy that overwrites it.
# TRUST_PROXY=1

# Solana RPC. The default public endpoint works for reads but rate limits
# hard and refuses getTokenLargestAccounts outright. Any provider endpoint
# (Helius, QuickNode, Triton) raises the ceiling for the trade indexer, which
# is the component most starved by the free tier.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter. Without a key, requests go to lite-api.jup.ag, which reports a
# remaining quota in single digits -- an eight-leg basket alone needs sixteen
# calls. With a key, requests move to api.jup.ag and the client raises its own
# rate budget to match.
# JUPITER_API_KEY=

# Pyth. Hermes rejects price reads without a key (HTTP 401) while leaving
# feed discovery open, so without this the oracle column in /api/price-truth
# is absent and the comparison falls back to the issuer mark alone.
# PYTH_API_KEY=

# Where the indexer and API keep state. Defaults to data/prestocks.db resolved
# against the repository root, so both processes agree regardless of cwd.
# DATABASE_PATH=

# Indexer cadence and per-pass work.
# INDEXER_INTERVAL_MS=300000
# SIGNATURES_PER_MINT=15
# INDEXER_ONCE=1

# Wallet signatures on mutating routes. Defaults to on; set to 0 only for
# local work. A deployment that forgets to configure this stays closed.
# REQUIRE_WALLET_SIGNATURE=1

# API port.
# PORT=3000

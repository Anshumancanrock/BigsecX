{
  "name": "prestocks-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "bun run scripts/run.ts",
    "test": "bun test",
    "typecheck": "bun ./node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.json",
    "api": "bun run --hot apps/api/src/server.ts",
    "indexer": "bun run apps/indexer/src/index.ts",
    "typecheck:web": "bun ./node_modules/typescript/lib/tsc.js --noEmit -p apps/web/tsconfig.json",
    "web": "bun run --cwd apps/web dev"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
